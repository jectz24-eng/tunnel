{
  "name": "tunnel",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "TUNNEL ($TUNNEL) — physics-inspired mining game with Solana SPL rewards",
  "workspaces": [
    "packages/sdk",
    "packages/db",
    "app",
    "packages/core",
    "services/engine"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "engine": "npm run start -w services/engine",
    "test": "npm run test -w packages/sdk && npm run test -w packages/core && npm run test -w services/engine && npm run test -w app",
    "test:e2e": "npm run test:e2e -w app",
    "typecheck": "npm run typecheck -w packages/sdk && npm run typecheck -w packages/core && npm run typecheck -w services/engine && npm run typecheck -w app",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "npm run migrate:deploy -w packages/db",
    "setup:token": "tsx scripts/create-token.ts",
    "setup:reward-wallet": "tsx scripts/reward-wallet.ts",
    "setup:fund": "tsx scripts/fund-reserve.ts",
    "admin": "tsx scripts/admin.ts",
    "admin:password-hash": "tsx scripts/admin-password-hash.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "tsx": "4.23.15",
    "tweetnacl": "^1.0.3",
    "typescript": "5.9.3"
  }
}
