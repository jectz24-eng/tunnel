{
  "name": "tunnel",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "TUNNEL ($TUNNEL) — quantum-inspired mining protocol on Solana",
  "workspaces": [
    "packages/sdk",
    "packages/db",
    "app",
    "packages/core",
    "services/engine"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w packages/sdk && npm run build -w app",
    "keeper": "npm run start -w services/keeper",
    "test": "npm run test -w packages/sdk && npm run test -w services/keeper && npm run test -w app",
    "test:e2e": "npm run test:e2e -w app",
    "test:anchor": "anchor test",
    "typecheck": "npm run typecheck -w packages/sdk && npm run typecheck -w services/keeper && npm run typecheck -w app",
    "db:local": "tsx scripts/local-postgres.ts",
    "setup:token": "tsx scripts/create-token.ts",
    "setup:protocol": "tsx scripts/initialize-protocol.ts",
    "setup:fund": "tsx scripts/fund-reserve.ts",
    "admin": "tsx scripts/admin.ts",
    "idl:sync": "tsx scripts/sync-idl.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@orao-network/solana-vrf": "0.8.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "chai": "^5.2.0",
    "dotenv": "^17.2.0",
    "mocha": "^11.7.0",
    "ts-mocha": "^11.1.0",
    "tsx": "4.23.15",
    "tweetnacl": "^1.0.3",
    "typescript": "5.9.3"
  }
}
