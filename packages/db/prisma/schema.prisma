// TUNNEL indexer database.
//
// Everything here is a *derived* view of onchain state. The chain is the only
// authority over outcomes and rewards; the keeper reconciles these tables
// against program accounts, and claimable balances are always re-read from
// chain before a claim.
//
// Spec mapping: Users → User · MiningCycles → Cycle · MiningAttempts → Experiment
// · Rewards → Position (+ Claim) · ProtocolConfiguration → ProtocolState
// · ProtocolEvents → IndexedEvent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

/// Every decoded program event, exactly once (idempotent on signature + index).
model IndexedEvent {
  id          BigInt    @id @default(autoincrement())
  signature   String
  eventIndex  Int
  slot        BigInt
  blockTime   DateTime?
  name        String
  cycleId     BigInt?
  owner       String?
  data        Json
  /// "confirmed" when first seen, upgraded to "finalized" by the reconciler.
  commitment  String    @default("confirmed")
  createdAt   DateTime  @default(now())

  @@unique([signature, eventIndex])
  @@index([name, id])
  @@index([cycleId])
  @@index([owner])
}

/// A wallet that has interacted with the protocol (from events or sign-in).
model User {
  wallet         String   @id
  firstSeenAt    DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([lastActivityAt])
}

model Cycle {
  id              BigInt    @id
  address         String
  status          String
  outcome         String
  openTs          DateTime
  closeTs         DateTime
  energyPerCycle  Int
  /// Snapshotted barrier configs and energy levels (JSON, from the Cycle account).
  barriers        Json
  levels          Json
  /// Snapshotted odds: { transmissionPpb: number[][], reward: string[][] }.
  odds            Json
  emissionBudget  BigInt
  participants    Int
  experiments     Int
  particles       BigInt[]
  energyUsed      BigInt
  vrfSeed         String?
  randomness      String?
  successes       BigInt[]
  totalNominal    BigInt
  tokensAllocated BigInt
  claims          Int
  tokensClaimed   BigInt
  settledAt       DateTime?
  swept           Boolean   @default(false)
  reconciledSlot  BigInt    @default(0)
  updatedAt       DateTime  @updatedAt

  positions Position[]

  @@index([status])
  @@index([openTs])
}

/// One wallet's participation in one cycle (the onchain Position account).
model Position {
  cycleId         BigInt
  owner           String
  address         String
  /// [barrier][level] flattened row-major (barrier × 5 + level).
  particles       Int[]
  successes       Int[]
  energyUsed      Int
  experiments     Int
  settled         Boolean
  nominalReward   BigInt
  claimed         Boolean
  tokensPaid      BigInt
  /// Payout computed with the SDK mirror of the program math (null until the cycle is final).
  expectedTokens  BigInt?
  claimSignature  String?
  firstSeenAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@id([cycleId, owner])
  @@index([owner])
}

/// One experiment = one `ParticlesDeployed` event (a mining attempt).
model Experiment {
  cycleId          BigInt
  owner            String
  /// Sequence number within the wallet's position for this cycle.
  seq              Int
  signature        String
  eventIndex       Int
  slot             BigInt
  blockTime        DateTime?
  barrier          Int
  level            Int
  count            Int
  firstIndex       Int
  energyCost       Int
  heightMilli      Int
  widthMilli       Int
  energyBps        Int
  transmissionPpb  Int
  /// Nominal $TUNNEL base units per successful particle.
  nominalReward    BigInt
  /// pending → awaiting_randomness → settled | void; "claimed" once paid.
  status           String    @default("pending")
  /// Derived from the revealed randomness (null until revealed).
  successes        Int?
  /// Per-particle outcomes as a bit string ("1" = tunneled), index order.
  outcomeBits      String?
  /// This experiment's share of the position payout (null until the cycle is final).
  rewardTokens     BigInt?
  updatedAt        DateTime  @updatedAt

  // No FK to Cycle: experiments are ingested from events, which can arrive
  // before the reconciler has created the cycle row.
  @@id([cycleId, owner, seq])
  @@unique([signature, eventIndex])
  @@index([owner, slot])
  @@index([slot])
  @@index([status])
  @@index([barrier])
}

/// One row per `RewardClaimed` event.
model Claim {
  signature  String
  eventIndex Int
  cycleId    BigInt
  owner      String
  tokens     BigInt
  outcome    Int
  blockTime  DateTime?
  slot       BigInt

  @@id([signature, eventIndex])
  @@index([owner])
  @@index([cycleId])
}

/// Per-wallet aggregates, recomputed from Position/Experiment rows (never incremented blindly).
model WalletStats {
  owner            String   @id
  cyclesPlayed     Int
  experiments      Int
  particles        BigInt
  successes        BigInt
  failures         BigInt
  energyUsed       BigInt
  /// Claimed + claimable (final cycles only).
  tokensEarned     BigInt
  tokensClaimed    BigInt
  bestCycleTokens  BigInt
  /// Longest run of consecutive played cycles with at least one tunnel.
  longestStreak    Int
  currentStreak    Int
  claimableCycles  Int
  updatedAt        DateTime @updatedAt

  @@index([tokensEarned])
  @@index([successes])
  @@index([particles])
  @@index([bestCycleTokens])
  @@index([longestStreak])
  @@index([cyclesPlayed])
}

/// Singleton mirror of the onchain Protocol account (ProtocolConfiguration).
model ProtocolState {
  id                   Int      @id @default(1)
  address              String
  admin                String
  gatekeeper           String
  tunnelMint           String
  rewardVault          String
  paused               Boolean
  params               Json
  odds                 Json
  nextCycleId          BigInt
  reserveAvailable     BigInt
  reserveFundedTotal   BigInt
  totalExperiments     BigInt
  totalParticles       BigInt
  totalEnergy          BigInt
  totalSuccesses       BigInt
  totalTokensAllocated BigInt
  totalTokensClaimed   BigInt
  cyclesSettled        BigInt
  slot                 BigInt
  updatedAt            DateTime @updatedAt
}

model IndexerCursor {
  id            String   @id
  lastSignature String?
  lastSlot      BigInt   @default(0)
  updatedAt     DateTime @updatedAt
}

/// Audit log of every crank transaction the keeper attempted.
model KeeperAction {
  id        BigInt   @id @default(autoincrement())
  kind      String
  cycleId   BigInt?
  target    String?
  signature String?
  status    String
  error     String?
  attempts  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([cycleId])
  @@index([status, createdAt])
}

/// Rate-limit buckets for the deployment co-signing service (gatekeeper) and APIs.
model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime

  @@index([windowEnd])
}
