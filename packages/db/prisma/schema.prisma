// TUNNEL database (v3, server-authoritative).
//
// The engine is the only writer of cycle state, settlement and payouts. The
// web app writes deployments (experiments) and claim requests, each inside a
// transaction that locks the rows it depends on. Fairness is public: every
// cycle publishes its seed commitment before deployments and reveals the seed
// after settlement.
//
// Spec mapping: Users → User · MiningCycles → Cycle · MiningAttempts → Experiment
// · Rewards → Position + Payout · ProtocolConfiguration → ProtocolConfig
// · ProtocolEvents → ProtocolEvent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

/// Singleton configuration (id = 1). Changes apply to cycles opened afterwards.
model ProtocolConfig {
  id                Int      @id @default(1)
  /// ProtocolParams (JSON; bigints as strings).
  params            Json
  /// Odds derived from params by the physics model (JSON; rewards as strings).
  odds              Json
  paused            Boolean  @default(false)
  tunnelMint        String?
  rewardWallet      String?
  /// Total $TUNNEL ever deposited into the reward wallet for mining (base units).
  reserveFundedTotal BigInt  @default(0)
  /// Written by the engine: on-chain $TUNNEL and SOL held by the reward wallet, latest slot, liveness.
  rewardWalletTokens BigInt?
  rewardWalletLamports BigInt?
  lastSlot          BigInt?
  engineHeartbeat   DateTime?
  /** Betting limits (base units). New bets are refused while bettingPaused. */
  minBet            BigInt   @default(1000000)
  maxBet            BigInt   @default(1000000000)
  /** A bet's maximum possible payout may not exceed this share (bps) of the free bankroll. */
  maxWinBps         Int      @default(500)
  bettingPaused     Boolean  @default(true)
  /** Newest house-account signature already scanned for deposits. */
  depositCursor     String?
  /** Set from /admin. The engine's RPC (may carry an API key; never sent to browsers). SOLANA_RPC_URL overrides it. */
  engineRpcUrl      String?
  /** Set from /admin. The RPC browsers use for balances and deposits. NEXT_PUBLIC_RPC_URL is the fallback. */
  publicRpcUrl      String?
  updatedAt         DateTime @updatedAt
}

model User {
  wallet         String   @id
  firstSeenAt    DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([lastActivityAt])
}

model Cycle {
  id               BigInt    @id
  /// open → closed → settled | void
  status           String
  outcome          String    @default("pending")
  openTs           DateTime
  closeTs          DateTime
  closedAt         DateTime?
  settledAt        DateTime?
  energyPerCycle   Int
  barriers         Json
  levels           Json
  odds             Json
  emissionBudget   BigInt
  /// sha256("TUNNEL/seed-commit/v3" ‖ seed), published at open.
  seedCommitment   String
  /// Secret until settlement. Never returned by the API before status = settled/void.
  serverSeed       String
  /// Randomness comes from the first produced Solana slot ≥ this one (after close).
  entropySlot      BigInt
  entropySlotUsed  BigInt?
  entropyBlockhash String?
  randomness       String?
  participants     Int       @default(0)
  experiments      Int       @default(0)
  particles        BigInt[]  @default([0, 0, 0])
  energyUsed       BigInt    @default(0)
  successes        BigInt[]  @default([0, 0, 0])
  totalNominal     BigInt    @default(0)
  tokensAllocated  BigInt    @default(0)
  updatedAt        DateTime  @updatedAt

  positions Position[]

  @@index([status])
  @@index([openTs])
}

/// One wallet's participation in one cycle.
model Position {
  cycleId       BigInt
  wallet        String
  /// [barrier][level] flattened row-major (barrier × 5 + level).
  particles     Int[]
  successes     Int[]
  energyUsed    Int
  experiments   Int
  settled       Boolean  @default(false)
  nominalReward BigInt   @default(0)
  /// Final $TUNNEL owed (null until the cycle is settled).
  payout        BigInt?
  payoutId      BigInt?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cycle Cycle @relation(fields: [cycleId], references: [id])

  @@id([cycleId, wallet])
  @@index([wallet])
  @@index([payoutId])
}

/// One experiment = one signed deployment (a mining attempt).
model Experiment {
  id              BigInt    @id @default(autoincrement())
  cycleId         BigInt
  wallet          String
  /// Sequence number within the wallet's position for this cycle.
  seq             Int
  barrier         Int
  level           Int
  count           Int
  firstIndex      Int
  energyCost      Int
  heightMilli     Int
  widthMilli      Int
  energyBps       Int
  transmissionPpb Int
  nominalReward   BigInt
  /// The exact signed message and its ed25519 signature (base58): non-repudiable proof of intent.
  message         String
  signature       String    @unique
  nonce           String
  createdAt       DateTime  @default(now())
  /// pending → settled | void; "claimed" once paid.
  status          String    @default("pending")
  successes       Int?
  outcomeBits     String?
  rewardTokens    BigInt?

  @@unique([cycleId, wallet, seq])
  @@index([wallet, id])
  @@index([cycleId])
  @@index([status])
  @@index([barrier])
}

/// A transfer of $TUNNEL from the reward wallet to a claimant.
model Payout {
  id                   BigInt    @id @default(autoincrement())
  /** "claim" (mining rewards) or "withdrawal" (casino balance). */
  kind                 String    @default("claim")
  wallet               String
  amount               BigInt
  /// requested → sending → confirmed | failed (amount returned to claimable)
  status               String    @default("requested")
  message              String
  messageSignature     String    @unique
  txSignature          String?
  /// For safe retries: a sent transaction is only resent once its blockhash has expired unconfirmed.
  lastValidBlockHeight BigInt?
  attempts             Int       @default(0)
  error                String?
  createdAt            DateTime  @default(now())
  confirmedAt          DateTime?

  @@index([wallet])
  @@index([status])
}

/// Append-only audit log of everything that changes protocol state.
model ProtocolEvent {
  id        BigInt   @id @default(autoincrement())
  name      String
  cycleId   BigInt?
  wallet    String?
  data      Json
  createdAt DateTime @default(now())

  @@index([name, id])
  @@index([cycleId])
  @@index([wallet])
}

/// Per-wallet aggregates, recomputed from Position rows (never incremented blindly).
model WalletStats {
  owner           String   @id
  cyclesPlayed    Int
  experiments     Int
  particles       BigInt
  successes       BigInt
  failures        BigInt
  energyUsed      BigInt
  tokensEarned    BigInt
  tokensClaimed   BigInt
  bestCycleTokens BigInt
  longestStreak   Int
  currentStreak   Int
  claimableCycles Int
  updatedAt       DateTime @updatedAt

  @@index([tokensEarned])
  @@index([successes])
  @@index([particles])
  @@index([bestCycleTokens])
  @@index([longestStreak])
  @@index([cyclesPlayed])
}

/// Engine job log (cycle transitions, settlement, payouts).
model EngineAction {
  id        BigInt   @id @default(autoincrement())
  kind      String
  cycleId   BigInt?
  target    String?
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

/// Fixed-window rate-limit buckets.
model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime

  @@index([windowEnd])
}

/// Nonces of accepted signed messages (replay protection beyond the freshness window).
model UsedNonce {
  nonce     String   @id
  wallet    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/** A player's casino balance and lifetime totals (base units). */
model Account {
  wallet            String   @id
  balance           BigInt   @default(0)
  deposited         BigInt   @default(0)
  withdrawn         BigInt   @default(0)
  wagered           BigInt   @default(0)
  returned          BigInt   @default(0)
  bets              Int      @default(0)
  particles         Int      @default(0)
  hits              Int      @default(0)
  biggestWin        BigInt   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([wagered])
  @@index([biggestWin])
  @@index([returned])
}

/** Provably-fair seeds: the server seed stays secret (only its hash is shown) until the player rotates. */
model SeedPair {
  id             BigInt    @id @default(autoincrement())
  wallet         String
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revealedAt     DateTime?

  @@index([wallet, active])
}

model Bet {
  id            BigInt   @id @default(autoincrement())
  wallet        String
  seedPairId    BigInt
  nonce         Int
  volatility    Int
  /** Stake per particle. */
  amount        BigInt
  count         Int
  winPpb        Int
  multiplierBps Int
  wins          Int
  payout        BigInt
  outcomeBits   String
  createdAt     DateTime @default(now())

  @@unique([seedPairId, nonce])
  @@index([wallet, id])
  @@index([payout])
  @@index([createdAt])
}

/** An on-chain $TUNNEL transfer into the house account, credited once. */
model Deposit {
  id          BigInt   @id @default(autoincrement())
  wallet      String
  amount      BigInt
  txSignature String   @unique
  slot        BigInt
  createdAt   DateTime @default(now())

  @@index([wallet])
}
