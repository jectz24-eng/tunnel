# Solana cluster for $TUNNEL balances and explorer links: localnet | devnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=mainnet-beta
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Server-only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# 32+ random bytes (hex) used to sign wallet-auth session cookies
SESSION_SECRET=
# /admin password hash: npm run admin:password-hash -- '<password>'
ADMIN_PASSWORD_HASH=
# LOCALNET ONLY: in-browser burner wallet for development/testing. Ignored on other clusters.
NEXT_PUBLIC_LOCAL_TEST_WALLET=false
