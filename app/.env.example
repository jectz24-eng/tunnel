# Cluster the app reads from and sends transactions to: localnet | devnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional override; defaults to the program id compiled into @tunnel/sdk
NEXT_PUBLIC_TUNNEL_PROGRAM_ID=
# Mainnet mining stays disabled in the UI unless this is exactly "true"
# AND the cluster is mainnet-beta. Do not set without owner authorization + audit.
NEXT_PUBLIC_MAINNET_DEPOSITS_ENABLED=false

# Server-only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# 32+ random bytes (hex) used to sign wallet-auth session cookies
SESSION_SECRET=
# Server-side RPC for API routes (defaults to NEXT_PUBLIC_RPC_URL)
SOLANA_RPC_URL=
# Optional deployment co-signer (gatekeeper). Path to its keypair JSON. Must match the onchain gatekeeper.
GATEKEEPER_KEYPAIR=
GATEKEEPER_WALLET_LIMIT_PER_HOUR=60
GATEKEEPER_IP_LIMIT_PER_HOUR=120
GATEKEEPER_GLOBAL_LIMIT_PER_MINUTE=600
# LOCALNET ONLY: in-browser burner wallet for development/testing. Ignored on other clusters.
NEXT_PUBLIC_LOCAL_TEST_WALLET=false
