# Cluster the app reads from and sends transactions to: localnet | devnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional override; defaults to the program id compiled into @tunnel/sdk
NEXT_PUBLIC_TUNNEL_PROGRAM_ID=
# Mainnet deposits stay disabled in the UI unless this is exactly "true"
# AND the cluster is mainnet-beta. Do not set without owner authorization + audit.
NEXT_PUBLIC_MAINNET_DEPOSITS_ENABLED=false

# Server-only
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# 32+ random bytes (hex) used to sign wallet-auth session cookies
SESSION_SECRET=
