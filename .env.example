# Local development only. Never commit real keys.

# ---- shared (scripts, engine) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
SOLANA_RPC_URL=http://127.0.0.1:8899
# Operator wallet used by setup scripts (holds the token supply before funding). Never commit it.
KEYPAIR_PATH=~/.config/solana/id.json

# ---- engine ----
# The reward wallet: holds the $TUNNEL mining reserve + SOL for transfer fees. Keep it OUT of the repo.
REWARD_WALLET_KEYPAIR=
TUNNEL_MINT=
ENGINE_TICK_MS=2000
ENGINE_PAYOUT_TICK_MS=4000
# Closed cycles whose entropy block cannot be read for this long are voided.
ENGINE_VOID_AFTER_MS=3600000
# Payouts above this many whole $TUNNEL wait for manual review.
ENGINE_MAX_PAYOUT_TOKENS=1000000
# Payouts wait while the reward wallet has less SOL than this (lamports).
ENGINE_MIN_FEE_LAMPORTS=20000000
LOG_LEVEL=info
