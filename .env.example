# ---- shared (scripts, keeper) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional websocket endpoint (defaults to the RPC URL's ws:// equivalent)
SOLANA_WS_URL=
# Operator / admin keypair used by setup scripts. Never commit it.
KEYPAIR_PATH=~/.config/solana/id.json
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# ---- keeper ----
# Hot wallet that pays round rent + ORAO request fees. Holds no user funds.
KEEPER_KEYPAIR=
KEEPER_ENABLE_CRANK=true
KEEPER_ENABLE_INDEXER=true
KEEPER_HEALTH_PORT=8787
LOG_LEVEL=info

# ---- mainnet guard (scripts refuse mainnet unless this exact value AND --confirm-mainnet) ----
# TUNNEL_MAINNET_AUTHORIZED=I_HAVE_OWNER_APPROVAL_AND_AN_INDEPENDENT_AUDIT
